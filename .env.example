# Copy to .env.local. Never commit the local file.
# Release credentials such as APPLE_ID and APPLE_APP_PASSWORD stay outside this file.
export WTM_HOME_PATH="/tmp/wtm-home"
export WTM_TEST_HOME_PATH="$WTM_HOME_PATH"
export WTM_SIGNING_IDENTITY="Developer ID Application: YOUR NAME (YOUR_TEAM_ID)"
export APPLE_TEAM_ID="YOUR_TEAM_ID"
