PRODUCT_BUNDLE_IDENTIFIER = de.powtac.whatthemodel
PRODUCT_NAME = WTM
MARKETING_VERSION = 0.3.0
CURRENT_PROJECT_VERSION = 3
MACOSX_DEPLOYMENT_TARGET = 15.0
ARCHS = arm64
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
CLANG_ENABLE_MODULES = YES
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = What The Model
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.developer-tools
INFOPLIST_KEY_NSDesktopFolderUsageDescription = WTM reads model files in Desktop folders you explicitly enable to calculate local model storage.
INFOPLIST_KEY_NSDocumentsFolderUsageDescription = WTM reads model files in Documents folders you explicitly enable to calculate local model storage.
INFOPLIST_KEY_NSDownloadsFolderUsageDescription = WTM reads model files in Downloads folders you explicitly enable to calculate local model storage.
INFOPLIST_KEY_NSRemovableVolumesUsageDescription = WTM reads model files on volumes you explicitly enable to calculate local model storage.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
