#!/bin/zsh
set -euo pipefail

if (( $# < 1 || $# > 2 )); then
  print -u2 "Usage: scripts/test-real-cache /absolute/path/to/huggingface/hub [--expect-partial]"
  exit 64
fi

real_cache_root="$1"
if [[ ! -d "$real_cache_root" ]]; then
  print -u2 "Hugging Face cache root does not exist: $real_cache_root"
  exit 66
fi

repository_root="${0:A:h:h}"
cd "$repository_root"

expect_partial=0
if (( $# == 2 )); then
  if [[ "$2" != "--expect-partial" ]]; then
    print -u2 "Unknown option: $2"
    exit 64
  fi
  expect_partial=1
fi

WTM_REAL_HF_CACHE="$real_cache_root" \
WTM_EXPECT_REAL_HF_PARTIAL="$expect_partial" \
swift test \
  --package-path Packages/WTMKit \
  --filter realHuggingFaceCacheHasNoManualDuplicates
