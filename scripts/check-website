#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
website_root="$repository_root/website"

if command -v rg >/dev/null 2>&1; then
  search() { rg "$@"; }
else
  search() {
    local flags=()
    while [[ "${1:-}" == -* ]]; do
      flags+=("$1")
      shift
    done
    grep -RE "${flags[@]}" "$@"
  }
fi

for required_file in index.html extend.html styles.css; do
  [[ -f "$website_root/$required_file" ]] || {
    echo "Missing website asset: $required_file" >&2
    exit 1
  }
done

for html_file in "$website_root"/*.html; do
  search -q '<html lang="en">' "$html_file" || { echo "Missing English lang: $html_file" >&2; exit 1; }
  search -q '<meta name="description"' "$html_file" || { echo "Missing description: $html_file" >&2; exit 1; }
  h1_count="$(python3 - "$html_file" <<'PY'
import re
import sys

html = open(sys.argv[1], encoding="utf-8").read()
print(len(re.findall(r"<h1(?:\s|>)", html, flags=re.IGNORECASE)))
PY
)"
  [[ "$h1_count" == 1 ]] || { echo "Expected one h1: $html_file" >&2; exit 1; }
  if python3 - "$html_file" <<'PY'
import re
import sys

html = open(sys.argv[1], encoding="utf-8").read()
for tag in re.findall(r"<img\b[^>]*>", html, flags=re.IGNORECASE | re.DOTALL):
    if not re.search(r"\balt\s*=", tag, flags=re.IGNORECASE):
        print(tag)
        raise SystemExit(0)
raise SystemExit(1)
PY
  then
    echo "Image without alt text: $html_file" >&2
    exit 1
  fi
done

while IFS= read -r reference; do
  target="${reference%%#*}"
  anchor="${reference#*#}"
  [[ "$reference" == *"#"* ]] || anchor=""
  [[ -z "$target" ]] && target="index.html"
  [[ -f "$website_root/$target" ]] || { echo "Broken local link: $reference" >&2; exit 1; }
  if [[ -n "$anchor" ]]; then
    search -q "id=\"$anchor\"" "$website_root/$target" || {
      echo "Broken local anchor: $reference" >&2
      exit 1
    }
  fi
done < <(search -o 'href="[a-zA-Z0-9._-]+\.html(#[a-zA-Z0-9._-]+)?"' "$website_root"/*.html | sed -E 's/.*href="([^"]+)"/\1/' | sort -u)

grep -Fq 'shasum -a 256 --ignore-missing -c checksums.sha256' "$website_root/index.html" || {
  echo "Installer must verify the downloaded DMG without requiring every release asset." >&2
  exit 1
}

checksum_fixture="$(mktemp -d "${TMPDIR:-/tmp}/wtm-installer-check.XXXXXX")"
trap 'rm -rf "$checksum_fixture"' EXIT INT TERM
printf 'fixture DMG\n' > "$checksum_fixture/WTM-0.0.0-arm64.dmg"
(
  cd "$checksum_fixture"
  shasum -a 256 WTM-0.0.0-arm64.dmg > checksums.sha256
  printf '%064d  WTM-0.0.0.spdx.json\n' 0 >> checksums.sha256
  printf '%064d  release-metadata.json\n' 0 >> checksums.sha256
  shasum -a 256 --ignore-missing -c checksums.sha256 >/dev/null
)

echo "Website structure, local links, baseline accessibility, and installer verification are valid."
